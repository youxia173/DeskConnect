include("${CMAKE_CURRENT_LIST_DIR}/../GitVersion.cmake")
function(check revision expected)
  set(DESKFLOW_VERSION_MAJOR 0)
  set(DESKFLOW_VERSION_MINOR 0)
  set(DESKFLOW_VERSION_PATCH 0)
  set(DESKFLOW_VERSION_TWEAK 0)
  set(DESKCONNECT_VERSION_SUFFIX "")
  deskconnect_parse_git_version("${revision}")
  set(actual "${DESKFLOW_VERSION_MAJOR}.${DESKFLOW_VERSION_MINOR}.${DESKFLOW_VERSION_PATCH}.${DESKFLOW_VERSION_TWEAK}${DESKCONNECT_VERSION_SUFFIX}")
  if(NOT actual STREQUAL expected)
    message(FATAL_ERROR "${revision}: expected ${expected}, got ${actual}")
  endif()
endfunction()
check("v1.27.5-0-g0123abcd" "1.27.5.0")
check("v1.27.5-12-g0123abcd" "1.27.5.12")
check("v1.26.20.0-0-g0123abcd" "1.26.20.0")
check("v1.28.0-bluetooth.1-0-g0123abcd" "1.28.0.0-bluetooth.1")
check("v1.28.0-bluetooth.1-23-g0123abcd" "1.28.0.23-bluetooth.1")
check("v12.30.41-beta-2-0-g0123abcd" "12.30.41.0-beta-2")
check("0123abcd" "0.0.0.0")
message(STATUS "Git version tests passed")
